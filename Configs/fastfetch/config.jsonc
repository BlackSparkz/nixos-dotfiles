{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    //"type": "kitty-icat",
    "type": "auto",
    "source": "$HOME/.config/fastfetch/NixOS.png",
    //"width": 30,           // Width in characters
    "height": 15,          // Height in characters
    "padding": {
        "top": 1,          // Top padding
        "left": 0,         // Left padding
        "right": 2,        // Right padding
        "bottom": 0        // Bottom padding
    }
},

    "display": {
        "separator": "  ➤ ",
        "constants": [
            "─────────────────"
        ],
        "key": {
            "type": "icon",
            "paddingLeft": 2
        }
    },

    "modules": [
        {
            "type": "custom",
            "format": "┌{$1} {#1}Hardware Flex{#} {$1}┐"
        },

        "host",
        "cpu",
        "gpu",
        "disk",
        "memory",
        "display",
        "battery",

        {
            "type": "custom",
            "format": "├{$1} {#1}Software Flex{#} {$1}┤"
        },

        "os",
        "kernel",
        "wm",
        "shell",
        "terminal",
        "terminalfont",
        "uptime",
        {
            "type": "custom",
            "format": "└{$1}───────────────{$1}┘"
        }
    ]
}
