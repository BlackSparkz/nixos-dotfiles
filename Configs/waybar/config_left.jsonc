{
  "reload_style_on_change": true,
  "toggle": true,
  "layer": "top",
  "position": "left",
  "width": 40,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,

  "modules-left": [
    "custom/logo",
    "clock",
    "hyprland/workspaces"
    //"cpu"
  ],

  "modules-center": [
    "mpris"
  ],

  "modules-right": [
    "group/extras",
    "network",
    "bluetooth",
    "pulseaudio#microphone",
    "pulseaudio",
    "backlight",
    "battery",
    "custom/powermenu"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "rotate": 90,
    "format-icons": {
      "active": "<span size='12pt'></span>",
      "default": "<span size='12pt'></span>"},
      "persistent-workspaces": {
        "*": 3
      }
  },

  "group/extras": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 400,
      "children-class": "extras",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/menu",
      "tray"
    ]
  },

  "custom/logo": {
    "format" : "",
    "tooltip": false,
    "tooltip-format": "App launcher",
    "on-click": "pkill rofi || rofi -show drun",
    "on-click-right": "foot"
  },

  "cpu": {
    "format": "{icon}",
    "format-icons": [
      "<span size='28pt'>⠁</span>",
      "<span size='28pt'>⠉</span>",
      "<span size='28pt'>⠙</span>",
      "<span size='28pt'>⠛</span>",
      "<span size='28pt'>⠟</span>",
      "<span size='28pt'>⠿</span>"
    ],
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "CPU Frequency: {avg_frequency} GHz",
    "on-click": "foot -e btop"
  },

  "clock": {
    "interval": 1,
    "format": "{:%H\n%M}",
    "format-alt": "{:%d\n%m\n%y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },

  "mpris": {
    "smooth-scrolling-threshold": 2.0,
    "tooltip": false,
    "tooltip-format": "{title}",
    "on-scroll-down": "playerctl position 3+",
    "on-scroll-up": "playerctl position 2-",
    "interval": 1,
    "rotate": 90,
    "max-length": 25,
    "format": "{player_icon} {title}",
    "format-status":"",
    "format-paused": "{status_icon} {title}",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "player-icons": {"default": "  "},
    "status-icons": {"paused": "  "}
  },

  "custom/menu": {
    "format": "<span size='18pt'>󰅃</span>",
    "tooltip": false
  },
  "tray": {
    "spacing": 16,
    "reverse-direction": true,
    "icon-size": 16,
    "show-passive-items": false
  },

  "network": {
    "format-icons": {
      "wifi": [
        "<span size='10pt'> </span>"
      ],
      "ethernet": "<span size='13pt'>󰈀 </span>",
      "disabled": "<span size='13pt'>󰤭 </span>",
      "disconnected": "<span size='13pt'>󰤩 </span>"
    },
    "format-wifi": "{icon}",
    "format-ethernet": "{icon}",
    "format-disconnected": "{icon}",
    "format-disabled": "{icon}",
    "interval": 2,
    "tooltip-format-wifi": "Connected: {essid} ({signalStrength}%)",
    "on-click-right": "footclient --app-id nmtui -e nmtui",
    "on-click-middle": "rfkill toggle wifi",
    "tooltip": true,
    "max-length": 20
  },

  "bluetooth": {
    "interval": 2,
    "format-on": "<span size='14pt'>󰂯</span>",
    "format-off": "<span size='14pt'>󰂲</span>",
    "format-disabled": "<span size='14pt'>󰂲</span>",
    "format-connected": "<span size='14pt'>󰂱</span>",
    "format-no-controller": "span size='14pt'>󰂯</span>",
    "tooltip": true,
    "tooltip-format-connected": "Connected: {device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_address} | Battery: {device_battery_percentage}%",
    "on-click-middle": "rfkill toggle bluetooth",
    "on-click-right": "footclient --app-id bluetui -e bluetui"
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "<span size='14pt'>󰍬</span>",
    "format-source-muted": "<span size='14pt'>󰍭</span>",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "footclient --app-id pulsemixer -e pulsemixer",
    "tooltip": false
  },

  "pulseaudio": {
    "interval": 1,
    "format": "{icon}",
    "format-icons": [
      "<span size='14pt'>󰕿</span>",
      "<span size='14pt'>󰖀</span>",
      "<span size='14pt'>󰕾</span>"
    ],
    "format-muted": "<span size='14pt'>󰝟</span>",
    "on-click-right": "footclient --app-id pulsemixer -e pulsemixer",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "reverse-scrolling": true,
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%",
    "ignored-sinks": [
      "Easy Effects Sink"
    ]
  },

  "backlight": {
    "format-icons": [ "󰃚","󰃛","󰃜","󰃝","󰃞","󰃟","󰃠" ],
    "reverse-scrolling": true,
    "smooth-scrolling-threshold": 2.0,
    "on-scroll-up": "brightnessctl set 1%+",
    "on-scroll-down": "brightnessctl set 1%-",
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%",
    "format": "{icon}",
    "on-click": "brightnessctl set 10%-",
    "on-click-right": "brightnessctl set 10%+",
    "on-click-middle": "bash ~/.config/Scripts/random_wall_on_home.sh"
  },

  "battery": {
    "interval": 2,
    "states": {
      "critical": 15
    },
    "format": "{icon}",
    "format-icons": { "default": [ "󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹" ] },
    "format-charging": "<span size='14pt'></span>",
    "format-plugged": "<span size='14pt'>󰚥</span>",
    "format-critical": "<span size='14pt'>󰂃</span>",
    "tooltip": true,
    "tooltip-format": "Charge: {capacity}%",
    "tooltip-format-charging": "Charging: {capacity}%"
  },
  "custom/powermenu": {
    "format": "<span size='11pt'></span>",
    "on-click": "wlogout",
    "on-click-middle": "systemctl poweroff",
    "on-click-right": "wlogout",
    "tooltip": false
  }
}
